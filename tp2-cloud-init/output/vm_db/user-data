#cloud-config
hostname: db01
manage_etc_hosts: true
users:
  - default
  - name: etudiant
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBdoORamYyjXI1I9B063iCRZtAQwj84IVEWpGgIQkqJ+ bd2c-tp2
ssh_pwauth: false
package_update: true
packages:
  - mariadb-server
runcmd:
  - [sh, -c, 'systemctl enable --now mariadb']
